{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://insightflow.local/evaluation/rag/gold/seeds/schema.json",
  "title": "RAG Gold Dataset Seed File",
  "type": "object",
  "required": [
    "dataset_key",
    "dataset_version",
    "split",
    "source_corpus_version",
    "workspace_public_id",
    "cases"
  ],
  "additionalProperties": false,
  "properties": {
    "dataset_key": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "dataset_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "split": {
      "type": "string",
      "enum": ["DEVELOPMENT", "VALIDATION", "FROZEN"]
    },
    "source_corpus_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "workspace_public_id": {
      "type": "string",
      "format": "uuid"
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/case" }
    }
  },
  "definitions": {
    "case": {
      "type": "object",
      "required": [
        "case_key",
        "question_text",
        "question_type",
        "difficulty",
        "should_refuse",
        "annotation_basis",
        "reviewer",
        "sort_order",
        "evidences",
        "assertions"
      ],
      "additionalProperties": false,
      "properties": {
        "case_key": { "type": "string", "minLength": 1, "maxLength": 120 },
        "question_text": { "type": "string", "minLength": 5 },
        "question_type": {
          "type": "string",
          "enum": [
            "SINGLE_DOCUMENT_FACT",
            "CROSS_DOCUMENT",
            "VERSION_CONFLICT",
            "OPERATION_PROCESS",
            "WORKSPACE_BOUNDARY",
            "REFUSAL"
          ]
        },
        "difficulty": { "type": "string", "enum": ["EASY", "MEDIUM", "HARD"] },
        "should_refuse": { "type": "boolean" },
        "annotation_basis": { "type": "string", "minLength": 5 },
        "reviewer": { "type": "string", "minLength": 1 },
        "sort_order": { "type": "integer", "minimum": 0 },
        "evidences": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/evidence" }
        },
        "assertions": {
          "type": "array",
          "minItems": 2,
          "items": { "$ref": "#/definitions/assertion" }
        }
      }
    },
    "evidence": {
      "type": "object",
      "required": ["granularity", "document_ref", "version_no", "chunk_no"],
      "additionalProperties": false,
      "properties": {
        "granularity": {
          "type": "string",
          "enum": ["DOCUMENT", "VERSION", "CHUNK"]
        },
        "document_ref": { "type": "string", "minLength": 1 },
        "version_no": { "type": "integer", "minimum": 1 },
        "chunk_no": { "type": "integer", "minimum": 1 },
        "requirement_key": { "type": "string", "minLength": 1, "maxLength": 120 }
      }
    },
    "assertion": {
      "type": "object",
      "required": ["assertion_type", "assertion_text", "weight"],
      "additionalProperties": false,
      "properties": {
        "assertion_type": {
          "type": "string",
          "enum": ["REQUIRED_FACT", "FORBIDDEN_CLAIM"]
        },
        "assertion_text": { "type": "string", "minLength": 1 },
        "weight": { "type": "number", "exclusiveMinimum": 0 }
      }
    }
  }
}
